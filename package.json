{
  "name": "fantasy-workspace",
  "version": "1.0.0",
  "description": "Fantasy sports applications monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "espn:dev": "cd apps/espn-fantasy-recap && npm run dev",
    "espn:stop": "cd apps/espn-fantasy-recap && npm run stop",
    "espn:status": "cd apps/espn-fantasy-recap && npm run status",
    "keeper:analyze": "cd apps/keeper-advisor && npm run analyze"
  },
  "keywords": ["fantasy", "sports", "monorepo"],
  "author": "",
  "license": "MIT"
}
