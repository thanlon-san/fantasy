{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "buildCommand": "pip install -r apps/baseball-engine/requirements.txt"
  },
  "deploy": {
    "startCommand": "cd apps/baseball-engine && python scripts/draft_server.py --host 0.0.0.0 --port ${PORT:-8001}",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
