{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "buildCommand": "pip install -r apps/baseball-api/requirements.txt"
  },
  "deploy": {
    "startCommand": "cd apps/baseball-api && uvicorn main:app --host 0.0.0.0 --port ${PORT:-8001}",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
