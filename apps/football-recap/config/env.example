# Football Recap — environment variables
# Copy this file to `.env` in the repo root (or the football-recap app dir).

# --- Production (Cursor Automation) -------------------------------------------
# The weekly automation only needs Yahoo OAuth in cloud secrets:
#   Cloud Agents dashboard → YAHOO_OAUTH_JSON = full oauth2.json body
# No Anthropic key required in cloud — the automation agent writes the recap.

# --- Yahoo Fantasy OAuth (required for data fetch) ------------------------------
# Loading order:
#   1. apps/football-recap/config/oauth2.json
#   2. apps/baseball-engine/config/oauth2.json  (shared token)
#   3. YAHOO_OAUTH_JSON env var (whole JSON body)
# YAHOO_OAUTH_JSON={"consumer_key":"...","consumer_secret":"...","access_token":"...","refresh_token":"..."}

# --- LLM providers (optional — local/manual runs only) ------------------------
# Used by scheduled_recap.py, compare_models.py, etc. NOT needed for the
# Cursor Automation production path.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-openai-key-here

# Optional Portkey gateway routing for OpenAI.
# PORTKEY_API_KEY=
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_OPENAI_VIRTUAL_KEY=

# --- Slack (optional fallback; automation uses Send to Slack tool) ------------
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_CHANNEL=#cx-retention-fantasy-football

# --- Current events -----------------------------------------------------------
# Do not set NEWSAPI_API_KEY. Recaps use the allowlist calendar
# (src/safe_calendar.py) plus week_data only. No NewsAPI, no politics,
# no invented world events.
