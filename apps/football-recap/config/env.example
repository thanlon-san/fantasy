# Fantasy Football API Configuration
# Copy this file to .env and fill in your actual values

# Option 1: Portkey Configuration (Recommended - LLM gateway with analytics)
# Get your keys at: https://portkey.ai
PORTKEY_API_KEY=your-portkey-api-key-here
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_OPENAI_VIRTUAL_KEY=your-portkey-openai-virtual-key-here

# Option 2: Direct OpenAI Configuration (Alternative)
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-key-here

# Optional: Anthropic API Key (alternative to GPT-4o)
# Get yours at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: API Base URL (only change if running on different host/port)
# API_BASE_URL=http://localhost:8000

# Slack Integration (for automatic recap posting)
# Choose ONE of the following methods:

# Method 1: Incoming Webhook (Easier Setup - Recommended)
# Create a webhook at: https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Method 2: Bot Token (More Features)
# Create a Slack app and install it: https://api.slack.com/apps
# Required scopes: chat:write, chat:write.public
# SLACK_BOT_TOKEN=xoxb-your-bot-token-here
# SLACK_CHANNEL=#fantasy-football

