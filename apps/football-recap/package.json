{
  "name": "@fantasy/football-recap",
  "version": "2.0.0",
  "description": "Yahoo Fantasy Football weekly AI recap generator (Cursor Automation + Slack draft delivery)",
  "private": true,
  "scripts": {
    "recap:prepare": "python3 scripts/prepare_recap_context.py --no-news",
    "recap:slack": "python3 scripts/prepare_slack_recap.py",
    "recap:finalize": "python3 scripts/finalize_recap.py",
    "recap": "python3 scripts/scheduled_recap.py",
    "recap:dry-run": "python3 scripts/scheduled_recap.py --dry-run",
    "logs": "tail -f logs/$(date +%Y%m%d).log"
  },
  "keywords": ["fantasy-football", "ai", "recap", "yahoo", "slack", "cursor-automation"],
  "author": "",
  "license": "MIT"
}
