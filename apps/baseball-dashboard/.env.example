# API Configuration
# Set to 'true' to use live API, 'false' for static JSON files
NEXT_PUBLIC_USE_API=false

# API Base URL (only needed if USE_API=true)
# Local development: http://localhost:8000
# Production: https://your-api.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# Draft Day live API server (run: python apps/keeper-advisor/scripts/draft_server.py)
# Local:      http://localhost:8001
# Production: https://your-railway-app.up.railway.app
NEXT_PUBLIC_DRAFT_API_URL=http://localhost:8001

# GitHub Token for triggering data refresh
# Create at: https://github.com/settings/tokens
# Required scopes: repo (for repository_dispatch)
GITHUB_TOKEN=your_github_token_here
GITHUB_REPOSITORY=thanlon-san/fantasy
