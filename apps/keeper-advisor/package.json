{
  "name": "@fantasy/keeper-advisor",
  "version": "0.1.0",
  "description": "Baseball Keeper League Decision Advisor",
  "private": true,
  "scripts": {
    "setup:yahoo": "bash -c 'source ../../.venv/bin/activate && python3 scripts/test_yahoo_oauth.py'",
    "fetch:roster": "bash -c 'source ../../.venv/bin/activate && python3 scripts/fetch_roster_with_draft.py'",
    "update:adp": "bash -c 'source ../../.venv/bin/activate && python3 scripts/auto_update_adp.py'",
    "waivers": "bash -c 'source ../../.venv/bin/activate && python3 scripts/waiver_wire.py'",
    "waivers:interactive": "bash -c 'source ../../.venv/bin/activate && python3 scripts/waiver_wire_interactive.py'",
    "breakouts": "bash -c 'source ../../.venv/bin/activate && python3 scripts/breakout_scanner.py'",
    "breakouts:pitchers": "bash -c 'source ../../.venv/bin/activate && python3 scripts/breakout_scanner.py --pitchers'",
    "lineup": "bash -c 'source ../../.venv/bin/activate && python3 scripts/daily_lineup.py'",
    "lineup:schedule": "bash -c 'source ../../.venv/bin/activate && python3 scripts/daily_lineup.py --schedule'",
    "analyze": "bash -c 'source ../../.venv/bin/activate && python3 scripts/keeper_cli.py --sample --scenarios'",
    "analyze:yahoo": "bash -c 'source ../../.venv/bin/activate && python3 scripts/keeper_cli.py --csv data/my_roster_from_yahoo.csv'",
    "analyze:ai": "bash -c 'source ../../.venv/bin/activate && python3 scripts/keeper_cli.py --sample --scenarios --ai'",
    "template": "bash -c 'source ../../.venv/bin/activate && python3 scripts/keeper_cli.py --create-template data/my_roster.csv'"
  },
  "keywords": ["baseball", "keeper-league", "fantasy-baseball", "yahoo", "ai"],
  "author": "",
  "license": "MIT"
}
