# Fantasy Football API Configuration
# Copy this file to .env and fill in your actual values

# Anthropic API Key (for Claude Sonnet 4.5 recap generation)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: OpenAI API Key (alternative to Claude)
# Get yours at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-key-here

# Optional: API Base URL (only change if running on different host/port)
# API_BASE_URL=http://localhost:8000

